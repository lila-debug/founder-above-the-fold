{
  "name": "dispatch-linkedin-mcp-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:visual-guide": "npm --prefix apps/visual-guide run dev",
    "build": "npm run build -w apps/web && npm run build -w apps/mcp-server",
    "build:visual-guide": "npm run build -w apps/visual-guide",
    "lint": "npm run lint -w apps/web",
    "lint:visual-guide": "npm run lint -w apps/visual-guide",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:core": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx --test apps/web/src/lib/server/posts.integration.test.ts",
    "test:mobile-auth": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx --test apps/web/src/lib/server/mobile-auth.test.ts",
    "test:mobile-auth:integration": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx --test apps/web/src/lib/server/mobile-auth.integration.test.ts",
    "test:voice-cloud": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx --test apps/web/src/lib/server/cloud-voice.test.ts",
    "test:language": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx --test apps/web/src/lib/server/voice.test.ts",
    "test:commerce": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx --test apps/web/src/lib/server/commerce.test.ts",
    "test:commerce:integration": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx --test apps/web/src/lib/server/commerce.integration.test.ts",
    "test:commerce:browser": "node scripts/commerce-browser-smoke.mjs",
    "test:owner-browser": "node scripts/owner-workbench-browser-smoke.mjs",
    "check:voice-cloud-live": "node scripts/cloud-voice-preflight.mjs",
    "check:production-launch": "node scripts/production-launch-preflight.mjs",
    "deploy:public-beta": "node scripts/deploy-public-beta.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "check:stripe": "node --env-file-if-exists=apps/web/.env.local scripts/stripe-sandbox-preflight.mjs",
    "check:stripe-sandbox": "npm run staging:stripe:preflight",
    "check:stripe-catalogue": "npm run staging:stripe:catalogue:audit",
    "provision:stripe-catalogue": "npm run staging:stripe:catalogue:provision",
    "check:stripe-webhook-live": "npm run staging:stripe:webhook:audit",
    "provision:stripe-sandbox": "npm run staging:stripe:webhook:provision",
    "staging:stripe:catalogue:audit": "node --env-file=apps/web/.env.stripe-sandbox.local scripts/provision-stripe-sandbox-catalogue.mjs",
    "staging:stripe:catalogue:provision": "APPLY_STRIPE_SANDBOX_CATALOGUE=true node --env-file=apps/web/.env.stripe-sandbox.local scripts/provision-stripe-sandbox-catalogue.mjs",
    "staging:stripe:preflight": "node --env-file=apps/web/.env.stripe-sandbox.local scripts/stripe-sandbox-preflight.mjs",
    "staging:stripe:webhook:audit": "node --env-file=apps/web/.env.stripe-sandbox.local scripts/provision-stripe-sandbox-webhook.mjs",
    "staging:stripe:webhook:provision": "APPLY_STRIPE_SANDBOX_WEBHOOK=true node --env-file=apps/web/.env.stripe-sandbox.local scripts/provision-stripe-sandbox-webhook.mjs",
    "staging:db:audit": "node --env-file=apps/web/.env.stripe-sandbox.local scripts/staging-database.mjs",
    "staging:db:migrate": "APPLY_STAGING_DATABASE_MIGRATIONS=true node --env-file=apps/web/.env.stripe-sandbox.local scripts/staging-database.mjs",
    "staging:deploy": "node --env-file=apps/web/.env.stripe-sandbox.local scripts/deploy-stripe-staging.mjs",
    "staging:lifecycle": "node --env-file=apps/web/.env.stripe-sandbox.local scripts/stripe-staging-lifecycle.mjs",
    "test:stripe-provisioning": "node --test scripts/stripe-staging-guards.test.mjs",
    "setup:licence-keys": "node scripts/generate-licence-keys.mjs apps/web/.env.local",
    "setup:update-keys": "node scripts/generate-update-keys.mjs apps/web/.env.local",
    "build:macos": "node scripts/build-macos-app.mjs",
    "audit:macos": "node scripts/audit-macos-app.mjs",
    "test:ios-simulator": "node scripts/ios-simulator-smoke.mjs",
    "test:update-feed": "node scripts/update-feed-smoke.mjs",
    "build:update-feed": "node scripts/build-macos-update-feed.mjs",
    "test:launch": "node scripts/launch-smoke.mjs",
    "test:product-hunt": "node scripts/product-hunt-readiness.mjs",
    "check:launch-offers": "node scripts/check-launch-offer-alignment.mjs",
    "test:contra": "node scripts/contra-buildathon-readiness.mjs",
    "test:accessibility": "node scripts/accessibility-release-audit.mjs",
    "build:product-hunt-gallery": "node scripts/build-product-hunt-gallery.mjs",
    "check:brand-footer": "node scripts/enforce-brand-footer.mjs --check",
    "fix:brand-footer": "node scripts/enforce-brand-footer.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "mcp:dev": "npm run dev -w apps/mcp-server",
    "mcp:build": "npm run build -w apps/mcp-server"
  },
  "dependencies": {
    "framer-motion": "^12.42.2"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
