# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DISPATCH_OWNER_EMAIL=
DISPATCH_OWNER_NAME=
CRON_SECRET=
INTERNAL_API_KEY=

# Magic link auth provider
# Use AUTH_PROVIDER=dev locally. Use AUTH_PROVIDER=resend in production.
AUTH_PROVIDER=dev
MAGIC_LINK_FROM=Dispatch <onboarding@resend.dev>
MAGIC_LINK_SECRET=
RESEND_API_KEY=
AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Database
DATABASE_URL=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
LINKEDIN_SCOPES=openid profile email w_member_social

# Secrets
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Voice gate
VOICE_QA_COMMAND=python scripts/british_qa.py
VOICE_DICTIONARY=en_GB

# MCP server
MCP_SERVER_NAME=dispatch-linkedin
MCP_TRANSPORT=stdio
MCP_API_BASE_URL=http://localhost:3000
MCP_API_KEY=
