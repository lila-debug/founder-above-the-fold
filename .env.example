# Local app URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
# Native callback registered by the iOS app. Production should use its verified universal link.
MOBILE_AUTH_CALLBACK_URL=founderabovefold://auth/exchange

# Owner-only access
AUTH_PROVIDER=dev
DISPATCH_OWNER_EMAIL=you@example.com
MAGIC_LINK_SECRET=replace-with-a-long-random-string

# Cookie consent
# Create a Cookiebot domain group, add your production domain, then paste the Domain ID here.
NEXT_PUBLIC_COOKIEBOT_ID=

# Public private-beta waitlist
# Waitlister dashboard > Overview > Waitlist key. This is a public form key, not an API secret.
# Whitelist founderaccount.com, www.founderaccount.com, and localhost in Waitlister.
NEXT_PUBLIC_WAITLISTER_KEY=

# Database
DATABASE_URL=postgres://user:password@localhost:5432/dispatch

# Internal app security
CRON_SECRET=replace-with-a-long-random-string
MCP_API_KEY=replace-with-a-long-random-string
TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Voice gate
# Requires hunspell and the en_GB dictionary on the machine running the web app.
VOICE_CHECK_COMMAND=["python3","scripts/british_qa.py"]
# Optional if the command must run from a specific folder.
VOICE_CHECK_CWD=

# Cloud Press to Speak (Deepgram)
# Keep the Deepgram key server-side. Create a separate long random value for the
# iOS voice-only socket, fit it in the server, then paste the same value into the
# native app's Settings > Cloud voice key. Do not commit either value.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-GB
IOS_VOICE_API_KEY=
# Credit fuse: 50 recordings or 100 MiB per UTC day, whichever comes first.
VOICE_DAILY_REQUEST_LIMIT=50
VOICE_DAILY_BYTE_LIMIT=104857600

# Production email provider
RESEND_API_KEY=
MAGIC_LINK_FROM="Founder Above the Fold <login@example.com>"

# Stripe — one premium transformation offer
# The US native sandbox is isolated staging evidence and can never be promoted.
# Live mode remains clamped to a separately proved Canadian seller account.
STRIPE_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOUNDER_TRANSFORMATION=
STRIPE_EXPECTED_ACCOUNT_ID=
# The documented seller is a Canadian federal corporation. Live checkout refuses
# any other account country; do not fit US keys merely because a sandbox was opened there.
STRIPE_EXPECTED_ACCOUNT_COUNTRY=CA
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_LIVE_APPROVED=false
STRIPE_CHECKOUT_ENABLED=false
# Direct Mac activation. Generate one Ed25519 keypair; keep PKCS8 private DER base64
# server-only and embed only the SPKI public DER base64 in the signed Mac build.
LICENCE_DEVICE_HASH_SECRET=
LICENCE_SIGNING_PRIVATE_KEY=
LICENCE_SIGNING_PUBLIC_KEY=

# Dedicated staging/provisioning slots belong in .env.stripe-sandbox.local, not
# the ordinary app environment. Runtime and provisioning keys must be different.
STRIPE_PROVISIONING_KEY=
STRIPE_STAGING_BASE_URL=
STRIPE_STAGING_VERCEL_PROJECT=founder-above-the-fold-stripe-staging
STAGING_DEPLOYMENT_APPROVED=false
NEON_STAGING_PROJECT_NAME=founder-above-the-fold-stripe-staging
STAGING_DATABASE_APPROVED=false
PRODUCTION_DATABASE_HOST=

# Direct Mac signed update feed. This must be a separate Ed25519 keypair: keep the
# PKCS8 private DER base64 offline/server-side and embed only the SPKI public key.
UPDATE_SIGNING_PRIVATE_KEY=
UPDATE_SIGNING_PUBLIC_KEY=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
# Add r_member_postAnalytics only after LinkedIn grants that product to this app.
# Without it, publishing works while own-post analytics stays permission-locked.
LINKEDIN_SCOPES="openid profile email w_member_social"
LINKEDIN_API_VERSION=202607
