# Local app URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Owner-only access
AUTH_PROVIDER=dev
DISPATCH_OWNER_EMAIL=you@example.com
MAGIC_LINK_SECRET=replace-with-a-long-random-string

# Cookie consent
# Create a Cookiebot domain group, add your production domain, then paste the Domain ID here.
NEXT_PUBLIC_COOKIEBOT_ID=

# Database
DATABASE_URL=postgres://user:password@localhost:5432/dispatch

# Internal app security
CRON_SECRET=replace-with-a-long-random-string
MCP_API_KEY=replace-with-a-long-random-string
TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Voice gate
# Requires hunspell and the en_GB dictionary on the machine running the web app.
VOICE_CHECK_COMMAND=["python3","scripts/british_qa.py"]
# Optional if the command must run from a specific folder.
VOICE_CHECK_CWD=

# Production email provider
RESEND_API_KEY=
MAGIC_LINK_FROM="Founder Above the Fold <login@example.com>"

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
LINKEDIN_SCOPES="openid profile email w_member_social"
